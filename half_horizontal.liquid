<div class="layout layout--row">
  {% assign enabled = data | where: 'enabled', true | sort: 'down_since' %}
  <div class="columns" data-overflow-max-cols="2" data-overflow-counter="true">
    <div class="column">
      {% for item in enabled %}
      {% render 'check' with item:item, index:forloop.index %}
      {% endfor %}
    </div>
  </div>
</div>
{% render 'title_bar' with error:error, data:data %}
